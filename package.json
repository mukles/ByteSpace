{
  "name": "doin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "turbo run db:up --filter=@repo/api",
    "db:down": "turbo run db:down --filter=@repo/api",
    "db:migrate": "turbo run db:migrate --filter=@repo/api"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "npm@11.6.1"
}
